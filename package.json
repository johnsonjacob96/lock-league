{
  "name": "lock-league",
  "version": "1.0.0",
  "private": true,
  "description": "Lock League \u2014 NFL pick league tracker",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --port 8765",
    "deploy": "wrangler pages deploy public",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o public/assets/tailwind.css --minify",
    "smoke": "node smoke/run.mjs",
    "smoke:render": "node smoke/run.mjs --render",
    "smoke:live": "node smoke/run.mjs --live",
    "smoke:all": "node smoke/run.mjs --all",
    "test": "node --experimental-test-module-mocks --test smoke/handlers.mjs smoke/ingestion.mjs smoke/prop-fetch.mjs smoke/cron.mjs",
    "smoke:browser": "RUN_BROWSER=1 node --experimental-test-module-mocks --test smoke/handlers.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19",
    "@electric-sql/pglite": "0.5.8"
  }
}
